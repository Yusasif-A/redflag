# G2 Scam Guard — environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed:
# the bot token controls your bot, and the LLM/STT keys are billable.
#
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────
# Telegram  (required for the bot; the API and glasses app run without it)
# ─────────────────────────────────────────────────────────────────────
# From @BotFather: /newbot, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# "polling" (default) needs no public HTTPS — use this for local demos.
# "webhook" is the production path and also needs PUBLIC_URL below.
TELEGRAM_MODE=polling

# Webhook mode only: your public https origin, no trailing slash.
# PUBLIC_URL=https://scamguard.example.com
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string

# ─────────────────────────────────────────────────────────────────────
# Risk engine
# ─────────────────────────────────────────────────────────────────────
# normal = fewer, stronger flags.  strict = flags earlier, more noise.
RISK_SENSITIVITY=normal

# Minimum level allowed onto the glasses: watch | high
LENS_MIN_LEVEL=watch

# ─────────────────────────────────────────────────────────────────────
# LLM  (optional — it only rewords the reason, never the score)
# ─────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible /v1 endpoint.
LLM_EXPLAIN_ENABLED=true
PUBLICA_LLM_ENDPOINT=
PUBLICA_LLM_MODEL=
PUBLICA_LLM_API_KEY=
LLM_TIMEOUT_MS=4000

# ─────────────────────────────────────────────────────────────────────
# Voice commands  (optional — tap and menu work without it)
# ─────────────────────────────────────────────────────────────────────
STT_ENABLED=true
STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v1
PAID_ELEVENLABS_API_KEY=
FREE_ELEVENLABS_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# Optional shared secret. Leave empty for local simulator work. Set it before
# exposing the backend beyond localhost, and give the same value to the app as
# VITE_SCAMGUARD_KEY.
SCAMGUARD_API_KEY=
